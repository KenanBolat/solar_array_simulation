# Copy to .env and adjust as needed. docker-compose reads this automatically.

# --- Safety master switch -------------------------------------------------
# Keep false unless you have completed docs/HARDWARE_INTEGRATION.md and intend
# to drive real instruments. false => every device uses the mock driver.
SAS_HARDWARE_ENABLED=false

# --- Database (TimescaleDB) ----------------------------------------------
SAS_DATABASE_URL=postgresql+asyncpg://sas:sas@db:5432/sas
SAS_DATABASE_URL_SYNC=postgresql+psycopg://sas:sas@db:5432/sas

# --- Cache / event bus ----------------------------------------------------
SAS_REDIS_URL=redis://redis:6379/0

# --- Auth -----------------------------------------------------------------
# Dev auth trusts the X-Dev-User header to impersonate a seeded user. Set to
# false and put a real identity provider in front for production.
SAS_DEV_AUTH_ENABLED=true

# --- Telemetry / retention -----------------------------------------------
SAS_TELEMETRY_INTERVAL_SECONDS=1.0
SAS_MEASUREMENT_RETENTION_DAYS=30

# --- Soft limits (hardware limits remain the ultimate authority) ----------
SAS_MAX_VOLTAGE_V=130
SAS_MAX_CURRENT_A=20

# --- Frontend -------------------------------------------------------------
# Browser-visible API base URL. Must be reachable from the user's browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
